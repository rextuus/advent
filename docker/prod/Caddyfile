# Advent – Caddy vor PHP-FPM (Dienst web in compose.prod.yaml).
# Nur HTTP: HTTPS und Zertifikat macht der Caddy auf dem VPS, der über WireGuard hierher weiterleitet.
{
	admin off
	servers {
		# Nur von diesen Adressen (dem VPS-Caddy) gelten X-Forwarded-For/-Proto; von allen anderen setzt Caddy
		# die Werte selbst (nicht fälschbar).
		trusted_proxies static {$REVERSE_PROXY_IPS:private_ranges}
		client_ip_headers X-Forwarded-For
	}
}

:80 {
	root * /srv/app/public
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Gebaute Assets tragen einen Hash im Namen und dürfen lange gecacht werden.
	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	php_fastcgi app:9000
	file_server
}
