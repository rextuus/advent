<div class="sketch-card p-6 text-center shadow-lg">
    <h2 class="text-2xl font-serif font-bold text-amber-900 mb-2">{{ slide.title }}</h2>
    <p class="text-base text-stone-700 leading-relaxed">{{ slide.text }}</p>

    <div class="sketch-card p-4 bg-amber-50/50 border-amber-200 mt-4">
        <p class="text-sm font-semibold text-stone-800 mb-3">{{ saunaQuestion.question }}</p>

        <div class="flex flex-col gap-2" id="sauna-buttons">
            <button onclick="sendSaunaChoice('{{ saunaQuestion.optionA }}')" class="py-2.5 px-3 bg-amber-700/90 text-amber-50 text-sm font-semibold rounded-lg active:scale-95 transition-all">
                🕰️ {{ saunaQuestion.optionA }}
            </button>
            <button onclick="sendSaunaChoice('{{ saunaQuestion.optionB }}')" class="py-2.5 px-3 bg-stone-700/90 text-stone-50 text-sm font-semibold rounded-lg active:scale-95 transition-all">
                🌙 {{ saunaQuestion.optionB }}
            </button>
        </div>

        <!-- Feedback-Container -->
        <div id="sauna-result" class="hidden mt-3 p-3 rounded-lg text-xs font-medium"></div>

        <!-- Hochkant-Bilder bei richtiger Antwort -->
        <div id="sauna-bonus-images" class="hidden grid-cols-2 gap-3 mt-4 pt-3 border-t border-amber-200/60">
            <div class="overflow-hidden rounded-xl border border-amber-300 shadow-md aspect-[3/4]">
                <img src="{{ saunaQuestion.theonImage }}" alt="Theon" class="w-full h-full object-cover">
            </div>
            <div class="overflow-hidden rounded-xl border border-amber-300 shadow-md aspect-[3/4]">
                <img src="{{ saunaQuestion.kumpirImage }}" alt="Kumpir" class="w-full h-full object-cover">
            </div>
        </div>
    </div>
</div>

<script>
    async function sendSaunaChoice(choiceName) {
        const response = await fetch('{{ path("app_journey_sauna_choice") }}', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ choice: choiceName })
        });
        const data = await response.json();
        const resultDiv = document.getElementById('sauna-result');
        const bonusImages = document.getElementById('sauna-bonus-images');

        resultDiv.textContent = data.message;
        resultDiv.classList.remove('hidden', 'bg-rose-100', 'text-rose-900', 'bg-emerald-100', 'text-emerald-900');

        if (data.success) {
            document.getElementById('sauna-buttons').classList.add('hidden');
            resultDiv.classList.add('bg-emerald-100', 'text-emerald-900');
            bonusImages.classList.remove('hidden');
            bonusImages.classList.add('grid');

            // Scroll-Sperre aufheben
            unlockSection('section-neptunbad-sauna');
        } else {
            resultDiv.classList.add('bg-rose-100', 'text-rose-900');
        }
    }
</script>