<div class="sketch-card p-5 text-center shadow-xl">
    <h2 class="text-xl font-serif font-bold text-amber-900 mb-1">{{ slide.title }}</h2>
    <p class="text-xs text-stone-600 mb-3 leading-relaxed">{{ slide.text }}</p>

    <!-- Würfel-Bereich -->
    <div class="my-2 p-3 bg-amber-100/60 rounded-xl border border-amber-300">
        <p class="text-xs font-semibold text-stone-700 mb-1">
            Würfele einen Viererpasch, Full House oder Kniffel!
        </p>
        <p class="text-[10px] text-stone-500 italic mb-2">
            Tipp: Klicke auf einen Würfel, um ihn rauszulegen.
        </p>

        <!-- Würfel Anzeigen -->
        <div id="dice-container" class="flex justify-center gap-2 mb-3">
            <div class="w-9 h-9 bg-white border-2 border-stone-800 rounded-lg flex items-center justify-center font-mono font-bold text-lg text-amber-900 shadow-sm cursor-pointer" onclick="toggleHold(0)"></div>
            <div class="w-9 h-9 bg-white border-2 border-stone-800 rounded-lg flex items-center justify-center font-mono font-bold text-lg text-amber-900 shadow-sm cursor-pointer" onclick="toggleHold(1)"></div>
            <div class="w-9 h-9 bg-white border-2 border-stone-800 rounded-lg flex items-center justify-center font-mono font-bold text-lg text-amber-900 shadow-sm cursor-pointer" onclick="toggleHold(2)"></div>
            <div class="w-9 h-9 bg-white border-2 border-stone-800 rounded-lg flex items-center justify-center font-mono font-bold text-lg text-amber-900 shadow-sm cursor-pointer" onclick="toggleHold(3)"></div>
            <div class="w-9 h-9 bg-white border-2 border-stone-800 rounded-lg flex items-center justify-center font-mono font-bold text-lg text-amber-900 shadow-sm cursor-pointer" onclick="toggleHold(4)"></div>
        </div>

        <button
                id="roll-dice-btn"
                onclick="rollKniffel()"
                class="w-full py-2.5 bg-amber-800 hover:bg-amber-700 text-white font-semibold rounded-xl text-xs transition-all shadow"
        >
            Würfeln! (1/3)
        </button>

        <!-- Versuchszähler -->
        <div id="attempt-counter" class="mt-3 text-xs font-medium text-amber-900 border-t border-amber-200/60 pt-2 hidden">
            Versuche: <span id="attempt-count" class="font-bold">0</span>
        </div>
    </div>

    <div id="kniffel-result" class="hidden p-2 rounded-lg text-xs font-medium mt-2"></div>
    <div id="category-selection" class="hidden mt-4">
        <p class="text-xs font-semibold text-stone-700 mb-2">Wähle eine Kategorie:</p>
        <div id="categories-container" class="grid grid-cols-2 gap-2 text-xs"></div>
    </div>
</div>

<script>
    let attempts = 0;
    let dice = [0, 0, 0, 0, 0];
    let held = [false, false, false, false, false];

    function toggleHold(index) {
        if (attempts === 0 || attempts >= 3) return;
        held[index] = !held[index];
        const diceDivs = document.getElementById('dice-container').children;
        diceDivs[index].classList.toggle('bg-amber-300', held[index]);
        diceDivs[index].classList.toggle('border-amber-600', held[index]);
        diceDivs[index].classList.toggle('ring-2', held[index]);
        diceDivs[index].classList.toggle('ring-amber-400', held[index]);
        diceDivs[index].classList.toggle('bg-white', !held[index]);
        diceDivs[index].classList.toggle('border-stone-800', !held[index]);
    }

    async function rollKniffel() {
        if (attempts >= 3) return;
        attempts++;

        const response = await fetch('{{ path("app_journey_kniffel_roll") }}', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
                attempts: attempts,
                dice: dice,
                held: held
            })
        });

        const data = await response.json();
        dice = data.dice;

        // Counter anzeigen & aktualisieren
        const counterDiv = document.getElementById('attempt-counter');
        const attemptCountSpan = document.getElementById('attempt-count');

        counterDiv.classList.remove('hidden');
        attemptCountSpan.textContent = attempts;

        const diceContainer = document.getElementById('dice-container');
        const resultDiv = document.getElementById('kniffel-result');
        const btn = document.getElementById('roll-dice-btn');

        diceContainer.innerHTML = '';
        dice.forEach((val, index) => {
            const die = document.createElement('div');
            die.className = `w-9 h-9 border-2 rounded-lg flex items-center justify-center font-mono font-bold text-base text-amber-900 shadow-sm ${attempts < 3 ? 'cursor-pointer' : ''} ${held[index] ? 'bg-amber-300 border-amber-600 ring-2 ring-amber-400' : 'bg-white border-stone-800'}`;
            die.textContent = val;
            if (attempts < 3) {
                die.onclick = () => toggleHold(index);
            }
            diceContainer.appendChild(die);
        });

        if (attempts < 3) {
            btn.textContent = `Würfeln! (${attempts + 1}/3)`;
        } else {
            btn.textContent = 'Versuche aufgebraucht';
            btn.disabled = true;
            btn.classList.add('opacity-50', 'cursor-not-allowed');
        }

        resultDiv.textContent = data.message;
        resultDiv.classList.remove('hidden', 'bg-rose-100', 'text-rose-900', 'bg-emerald-100', 'text-emerald-900');

        if (data.success) {
            resultDiv.classList.add('bg-emerald-100', 'text-emerald-900');
            btn.classList.add('hidden');
            renderCategories(data.scores);
        } else {
            resultDiv.classList.add('bg-rose-100', 'text-rose-900');
        }
    }

    function renderCategories(scores) {
        const container = document.getElementById('categories-container');
        const selectionDiv = document.getElementById('category-selection');
        container.innerHTML = '';
        
        for (const [category, score] of Object.entries(scores)) {
            const btn = document.createElement('button');
            btn.className = 'p-2 bg-amber-50 hover:bg-amber-100 border border-amber-200 rounded-lg text-amber-900 font-semibold';
            btn.textContent = `${category}: ${score} Pkt`;
            btn.onclick = () => finishGame(category, score);
            container.appendChild(btn);
        }
        selectionDiv.classList.remove('hidden');
    }

    function finishGame(category, score) {
        const resultDiv = document.getElementById('kniffel-result');
        const selectionDiv = document.getElementById('category-selection');
        
        selectionDiv.classList.add('hidden');
        resultDiv.textContent = `Gewählt: ${category} mit ${score} Punkten! Gut gemacht!`;
        resultDiv.classList.remove('hidden', 'bg-rose-100', 'text-rose-900', 'bg-emerald-100', 'text-emerald-900');
        resultDiv.classList.add('bg-emerald-100', 'text-emerald-900');
        
        // Unblock game
        unlockSection('section-rio-kniffel');
    }
</script>