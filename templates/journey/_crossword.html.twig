<div class="sketch-card p-1 sm:p-2 text-center shadow-lg {{ slide.id == 'crossword-intro' ? 'h-auto' : 'h-full' }} flex flex-col gap-4 {{ slide.id == 'crossword-game' ? 'justify-between' : 'justify-center' }} relative">
    <style>
        .perspective-1000 { perspective: 1000px; }
        .transform-style-3d { transform-style: preserve-3d; }
        .backface-hidden { backface-visibility: hidden; }
        .rotate-y-180 { transform: rotateY(180deg); }
        .flipped { transform: rotateY(180deg); }
    </style>
    
    <div class="relative">
        <h2 class="text-xl sm:text-2xl font-serif font-bold text-black mb-2">{{ slide.title }}</h2>
        <p class="text-sm sm:text-base text-stone-700 leading-relaxed">{{ slide.text }}</p>
        
        <!-- Toggle Button -->
        {% if slide.id == 'crossword-game' %}
            <button onclick="toggleCrosswordView()" class="absolute -top-2 -left-2 z-20 p-2 bg-stone-200 hover:bg-stone-300 rounded-full transition-colors shadow-sm">
                ⟳
            </button>
        {% endif %}
    </div>

    {% if slide.id == 'crossword-game' %}
        <div id="crossword-flip-container" class="mt-4 perspective-1000 flex-1 min-h-0 w-full">
            <div id="crossword-flip-inner" class="relative w-full h-full transition-transform duration-500 transform-style-3d">
                
                <!-- Front: Grid -->
                <div id="crossword-grid" class="absolute inset-0 backface-hidden w-full h-full overflow-auto p-1 flex justify-center items-center bg-white">
                    <!-- Grid generated by JS -->
                </div>

                <!-- Back: Hints -->
                <div id="clues" class="absolute inset-0 backface-hidden rotate-y-180 w-full h-full p-2 text-xs text-stone-700 text-left overflow-y-auto bg-white border border-stone-200 rounded-lg">
                    <p class="mb-2 font-bold text-stone-900 border-b border-stone-300 pb-1">Hinweise:</p>
                    <ul class="space-y-1">
                        {% for entry in crosswordData.entries %}
                            <li class="flex gap-2">
                                <span class="font-bold min-w-[20px]">{{ entry.number }}:</span>
                                <span>{{ entry.clue }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
        
        <!-- Modal Popup -->
        <div id="hint-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50 p-4" onclick="hideHint()">
            <div class="bg-white p-6 rounded-lg shadow-xl max-w-sm w-full" onclick="event.stopPropagation()">
                <h3 id="hint-number" class="text-lg font-bold text-black mb-2"></h3>
                <p id="hint-text" class="text-stone-700"></p>
                <button onclick="hideHint()" class="mt-6 w-full py-2 bg-black text-white rounded-lg font-semibold hover:bg-stone-800 transition-colors">Schließen</button>
            </div>
        </div>

        <!-- Action Container -->
        <div class="mt-2 flex flex-col gap-2">
            <button
                    onclick="unlockSection('section-crossword-game')"
                    class="w-full py-1.5 bg-black text-white rounded-lg font-semibold text-xs hover:bg-stone-800 transition-colors"
            >
                Rätsel fertig? Weiter geht's!
            </button>
            <div class="flex gap-2">
                <button onclick="repeatCrossword()" class="flex-1 py-1 bg-stone-200 text-black rounded-lg font-semibold text-[9px] hover:bg-stone-300 transition-colors">
                    Wiederholen
                </button>
                <button onclick="unlockSection('section-crossword-game', true)" class="flex-1 py-1 bg-stone-200 text-black rounded-lg font-semibold text-[9px] hover:bg-stone-300 transition-colors">
                    Überspringen
                </button>
            </div>
        </div>
    {% endif %}
</div>

<script>
    function repeatCrossword() {
        // Clear all inputs
        document.querySelectorAll('#crossword-grid input').forEach(input => input.value = '');
    }
    function showHint(number, text) {
        document.getElementById('hint-number').textContent = 'Hinweis ' + number;
        document.getElementById('hint-text').textContent = text;
        document.getElementById('hint-modal').classList.remove('hidden');
    }
    
    function hideHint() {
        document.getElementById('hint-modal').classList.add('hidden');
    }

    function toggleCrosswordView() {
        document.getElementById('crossword-flip-inner').classList.toggle('flipped');
    }

    {% if slide.id == 'crossword-game' %}
    (function() {
        const gridData = {{ crosswordData.grid|json_encode|raw }};
        const entries = {{ crosswordData.entries|json_encode|raw }};
        const container = document.getElementById('crossword-grid');
        
        // Map numbers to cells and hint text
        const numbers = {};
        const hints = {};
        entries.forEach(entry => {
            const key = `${entry.row - 1}-${entry.col - 1}`;
            if (!numbers[key] || entry.number < numbers[key]) {
                numbers[key] = entry.number;
            }
            if (!hints[entry.number]) {
                hints[entry.number] = [];
            }
            hints[entry.number].push(`${entry.direction === 'across' ? 'Waagerecht' : 'Senkrecht'}: ${entry.clue}`);
        });
        
        const table = document.createElement('table');
        table.className = 'border-collapse';
        
        gridData.forEach((rowStr, rowIndex) => {
            const tr = document.createElement('tr');
            rowStr.split('').forEach((char, colIndex) => {
                const td = document.createElement('td');
                td.className = 'relative w-5 h-5 sm:w-7 sm:h-7';
                
                if (char === '#') {
                    // Do nothing
                } else {
                    td.className += ' border border-black bg-white p-0 text-center';
                    
                    // Add number if starts here
                    const key = `${rowIndex}-${colIndex}`;
                    if (numbers[key]) {
                        const number = numbers[key];
                        const numberSpan = document.createElement('span');
                        numberSpan.className = 'absolute top-0 left-0 text-[10px] font-bold p-0.5 leading-none cursor-pointer hover:bg-stone-200';
                        numberSpan.textContent = number;
                        
                        // Show hint on click
                        numberSpan.onclick = function() {
                            const hintText = hints[number].join(' | ');
                            showHint(number, hintText);
                        };
                        
                        td.appendChild(numberSpan);
                    }
                    
                    const input = document.createElement('input');
                    input.className = 'w-full h-full text-center uppercase font-bold text-black bg-white focus:bg-stone-100 outline-none text-xs sm:text-sm';
                    input.maxLength = 1;
                    td.appendChild(input);
                }
                tr.appendChild(td);
            });
            table.appendChild(tr);
        });
        
        container.appendChild(table);
    })();
    {% endif %}
</script>
