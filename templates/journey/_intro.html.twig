<div class="sketch-card p-4 sm:p-5 text-center shadow-xl flex flex-col justify-between max-h-[90vh]">
    <div>
        <h2 class="text-lg sm:text-xl font-serif font-bold text-amber-900 mb-1">{{ slide.title }}</h2>
        <p class="text-[11px] sm:text-xs text-stone-600 mb-2 leading-relaxed">{{ slide.text }}</p>
    </div>

    <!-- Rollenauswahl -->
    <div class="flex flex-col gap-1.5 my-1 text-left">
        <p class="text-[11px] font-semibold text-stone-700 text-center mb-0.5">Wähle deine Identität:</p>

        <!-- Kristin -->
        <button onclick="selectRole('kristin', 'Klar darfst du das machen! ❤️ Auf geht\'s in dein Geburtstags-Abenteuer.')" class="p-2 bg-amber-100/80 hover:bg-amber-200 border border-amber-300 rounded-xl transition flex flex-col">
            <div class="flex items-center justify-between w-full">
                <span class="text-xs font-bold text-amber-900">✨ Ich bin Kristin</span>
                <span class="text-[10px] text-amber-700 font-medium">Hauptperson</span>
            </div>
            <span class="text-[10px] text-stone-600 mt-0.5">Der Geburtstag dreht sich heute komplett um dich.</span>
        </button>

        <!-- Freunde -->
        <button onclick="selectRole('freunde', 'Freunde von Kresh? Na klar, ihr dürft natürlich auch rein – solange ihr keine Getränke verschüttet! 😉')" class="p-2 bg-stone-100 hover:bg-stone-200 border border-stone-200 rounded-xl transition flex flex-col">
            <div class="flex items-center justify-between w-full">
                <span class="text-xs font-bold text-stone-800">🍻 Freunde von Kresh</span>
                <span class="text-[10px] text-stone-500 font-medium">Party-Crew</span>
            </div>
            <span class="text-[10px] text-stone-500 mt-0.5">Hab zwar keinen Ausweis dabei, aber zahle einfach nen Euro extra.</span>
        </button>

        <!-- Verwandte -->
        <button onclick="selectRole('verwandte', 'Verwandte? Herzlich willkommen! Aber psst... keine Sorge, hier gibt es absolut keine Targaryen-Inzest-Vibes, versprochen! 🐉')" class="p-2 bg-stone-100 hover:bg-stone-200 border border-stone-200 rounded-xl transition flex flex-col">
            <div class="flex items-center justify-between w-full">
                <span class="text-xs font-bold text-stone-800">👑 Verwandte</span>
                <span class="text-[10px] text-stone-500 font-medium">Familienbande</span>
            </div>
            <span class="text-[10px] text-stone-500 mt-0.5">Stammbaum intakt, Drachen im Stall – absolut safe.</span>
        </button>

        <!-- Kollege -->
        <button onclick="selectRole('kollege', 'Arbeitskollege? Du darfst zwar auch passieren, aber wehe, du bringst Jira-Tickets mit in den Geburtstag! 💻')" class="p-2 bg-stone-100 hover:bg-stone-200 border border-stone-200 rounded-xl transition flex flex-col">
            <div class="flex items-center justify-between w-full">
                <span class="text-xs font-bold text-stone-800">💼 Arbeitskollege</span>
                <span class="text-[10px] text-stone-500 font-medium">Office-Support</span>
            </div>
            <span class="text-[10px] text-stone-500 mt-0.5">Dienst nach Vorschrift, aber heute nur mit Feierlaune.</span>
        </button>

        <!-- Nichts von alledem -->
        <button onclick="selectRole('nichts', 'Nichts von alledem?! Moment mal... In welchem Paralleluniversum lebst du denn bitte?! Du verpasst hier gerade die einzige, wahrhaftige Kristin des gesamten Kosmos! Aber gut, ausnahmsweise darfst du trotzdem einen Blick riskieren, wenn du mutig genug bist! 🌌')" class="p-2 bg-stone-100 hover:bg-stone-200 border border-stone-200 rounded-xl transition flex flex-col">
            <div class="flex items-center justify-between w-full">
                <span class="text-xs font-bold text-stone-800">❓ Nichts von alledem</span>
                <span class="text-[10px] text-stone-500 font-medium">Verwirrter Zeitreisender</span>
            </div>
            <span class="text-[10px] text-stone-500 mt-0.5">Weiß nicht, wie du hiergelandet bist, aber du ziehst es jetzt durch.</span>
        </button>
    </div>

    <!-- Feedback & Weiter Button -->
    <div class="mt-2">
        <div id="intro-feedback" class="hidden p-2.5 rounded-xl text-xs font-medium bg-amber-50 border border-amber-200 text-amber-900 mb-2 leading-relaxed"></div>

        <button
                id="intro-next-btn"
                disabled
                class="w-full py-2.5 bg-stone-300 text-stone-500 font-semibold rounded-xl text-xs transition-all shadow cursor-not-allowed"
                onclick="proceedJourney()"
        >
            👆 Wähle erst deine Rolle aus
        </button>
    </div>
</div>

<script>
    function selectRole(roleKey, message) {
        const feedbackDiv = document.getElementById('intro-feedback');
        const nextBtn = document.getElementById('intro-next-btn');

        feedbackDiv.textContent = message;
        feedbackDiv.classList.remove('hidden');

        nextBtn.disabled = false;
        nextBtn.classList.remove('bg-stone-300', 'text-stone-500', 'cursor-not-allowed');
        nextBtn.classList.add('bg-amber-800', 'hover:bg-amber-700', 'text-white');
        nextBtn.textContent = '🚀 Ab in die Journey!';
    }

    function proceedJourney() {
        unlockSection('section-intro-role');

        const nextSection = document.getElementById('section-neptunbad-aussen');
        if (nextSection) {
            nextSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    }
</script>