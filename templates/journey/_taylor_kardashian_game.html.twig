<div class="sketch-card p-4 sm:p-5 text-center shadow-xl flex flex-col justify-between max-h-[90vh]">
    <div>
        <h2 class="text-lg sm:text-xl font-serif font-bold text-amber-900 mb-1">{{ slide.title }}</h2>
        <p class="text-[11px] sm:text-xs text-stone-600 mb-2 leading-relaxed" id="quiz-subtitle">{{ slide.text }}</p>
    </div>

    <!-- Quiz-Container -->
    <div id="quiz-container" class="my-2 text-left bg-amber-100/60 p-3 rounded-xl border border-amber-300">
        <div class="flex justify-between items-center mb-2">
            <span class="text-[10px] font-bold text-amber-800 uppercase tracking-wider" id="question-indicator">Frage 1 von 10</span>
            <span class="text-[10px] text-stone-500 font-medium" id="score-display">Punkte: 0/10</span>
        </div>

        <p class="text-xs font-semibold text-stone-800 mb-3" id="question-text">Fragen-Text wird geladen...</p>

        <div class="grid grid-cols-1 gap-2" id="options-container">
            <!-- Dynamische Buttons werden hier eingefügt -->
        </div>
    </div>

    <!-- Ergebnis & Weiter Button -->
    <div class="mt-2">
        <div id="tk-game-feedback" class="hidden p-2 rounded-xl text-xs font-medium bg-amber-50 border border-amber-200 text-amber-900 mb-2 leading-relaxed"></div>

        <button
                id="tk-game-next-btn"
                disabled
                class="w-full py-2.5 bg-stone-300 text-stone-500 font-semibold rounded-xl text-xs transition-all shadow cursor-not-allowed"
                onclick="unlockSection(this)"
        >
            Beantworte alle Fragen zum Freischalten
        </button>

        <div class="flex gap-2 mt-6">
            <button onclick="repeatQuiz()" class="flex-1 py-1 bg-stone-200 text-black font-semibold rounded-xl text-[9px] transition-all shadow">
                Wiederholen
            </button>
            <button onclick="unlockSection(this)" class="flex-1 py-1 bg-stone-200 text-black font-semibold rounded-xl text-[9px] transition-all shadow">
                Überspringen
            </button>
        </div>
    </div>
</div>

<script>
    window.repeatQuiz = function() {
        currentQuestion = 0;
        score = 0;
        document.getElementById('quiz-container').classList.remove('hidden');
        document.getElementById('quiz-subtitle').textContent = '{{ slide.text }}';
        document.getElementById('tk-game-feedback').classList.add('hidden');
        const nextBtn = document.getElementById('tk-game-next-btn');
        nextBtn.disabled = true;
        nextBtn.classList.add('bg-stone-300', 'text-stone-500', 'cursor-not-allowed');
        nextBtn.classList.remove('bg-amber-800', 'hover:bg-amber-700', 'text-white');
        nextBtn.textContent = 'Beantworte alle Fragen zum Freischalten';
        loadQuestion();
    };

    const quizData = [
        {
            question: "1. „***, there's people that are dying.“ An wen war dieser legendäre Satz von Kourtney Kardashian gerichtet?",
            options: [
                { text: "An Kim, weil sie wegen einer verlorenen Diamant-Ohrring-Quaste am Pool weinte", correct: true },
                { text: "An Kris Jenner, weil das Frühstück um fünf Minuten verschoben wurde", correct: false }
            ]
        },
        {
            question: "2. Sex and the City: In welcher legendären Staffel und Situation verliert Carrie aus Versehen ihren Manolo Blahnik auf einer Party?",
            options: [
                { text: "Bei der Vogue-Party, als sie von niemand Geringerem als Anna Wintour persönlich angesprochen wird", correct: false },
                { text: "Bei der Babyparty von Laney in Greenwich, wo alle Gäste ihre Schuhe ausziehen müssen", correct: true }
            ]
        },
        {
            question: "3. Taylor Swift & die Easter Eggs: Welcher Song aus dem Album ‚Reputation‘ war von Anfang an als direkte Abrechnung geplant?",
            options: [
                { text: "Look What You Made Me Do – komplett untermauert durch die Snake-Symbolik", correct: true },
                { text: "Getaway Car – weil sie darin den Auszug aus dem Apartment besingt", correct: false }
            ]
        },
        {
            question: "4. Sex and the City: Welche Blumen bringt Jack Berger Carrie mit, bevor er mitten in der Nacht verschwindet und ihr das berühmte Post-it hinterlässt?",
            options: [
                { text: "Nelken", correct: true },
                { text: "Rote Rosen", correct: false }
            ]
        },
        {
            question: "5. Calabasas-Geheimnisse: Welcher Signature-Drink gehört laut Khloé Kardashians akribisch sortierter Speisekammer zwingend in den Clear-Container?",
            options: [
                { text: "Exakt beschriftete Oreos, bei denen jede Reihe mit einem Zahnstocher ausgerichtet ist", correct: true },
                { text: "Importierter Matcha-Tee direkt aus Kyoto", correct: false }
            ]
        },
        {
            question: "6. Eras Tour Highlight: Bei welchem Song trat Travis Kelce in Frack und Zylinder überraschend als Tänzer auf die Bühne und trug Taylor auf ein Sofa?",
            options: [
                { text: "I Can Do It With a Broken Heart", correct: true },
                { text: "Karma", correct: false }
            ]
        },
        {
            question: "7. Englisches Königshaus: Welches ikonische Outfit von Prinzessin Diana ging als die ultimative ‚Revenge Dress‘-Antwort in die Geschichte ein?",
            options: [
                { text: "Das schulterfreie, kurze schwarze Kleid am Abend von Charles' Geständnis", correct: true },
                { text: "Der rote Jogginganzug bei ihrem ersten Solo-Auftritt nach der Trennung", correct: false }
            ]
        },
        {
            question: "8. Schwedisches Königshaus: Welches royale Familienmitglied sorgte mit seiner wilden Sturm-und-Drang-Zeit und dem legendären Weg zur Liebe für die meiste Boulevard-Faszination?",
            options: [
                { text: "Prinzessin Madeleine mit ihrem Rückzug nach New York nach gelöster Verlobung", correct: false },
                { text: "Prinzessin Victoria, die sich stur und skandalfrei gegen alle Hof-Konventionen ihren Fitnesstrainer Daniel angelangt hat", correct: true }
            ]
        },
        {
            question: "9. Reality-TV-History: Wer hat den Begriff ‚Contour‘ in den 2010er Jahren durch Make-up-Tutorials weltweit salonfähig gemacht?",
            options: [
                { text: "Huda Kattan und Kim Kardashians langjähriger Make-up-Artist Mario Dedivanovic", correct: true },
                { text: "Kylie Jenner mit dem Launch ihrer allerersten Lip Kit Kollektion", correct: false }
            ]
        },
        {
            question: "10. Das große Finale: Wer verbindet all diese Welten aus Glamour, Pop-Kultur und perfekten Vibes am stilvollsten?",
            options: [
                { text: "Kris Jenner im Management-Modus mit einem Martini in der Hand", correct: false },
                { text: "Kristin, die das alles sowieso jeden einzelnen Tag mit purer Eleganz kombiniert", correct: true }
            ]
        }
    ];

    let currentQuestion = 0;
    let score = 0;

    function loadQuestion() {
        if (currentQuestion >= quizData.length) {
            showFinalResult();
            return;
        }

        const q = quizData[currentQuestion];
        document.getElementById('question-indicator').textContent = `Frage ${currentQuestion + 1} von ${quizData.length}`;
        document.getElementById('score-display').textContent = `Punkte: ${score}/${quizData.length}`;
        document.getElementById('question-text').textContent = q.question;

        const optionsContainer = document.getElementById('options-container');
        optionsContainer.innerHTML = '';

        q.options.forEach((opt) => {
            const btn = document.createElement('button');
            btn.className = 'p-2.5 bg-white hover:bg-amber-50 border border-stone-300 rounded-xl text-xs font-semibold text-stone-800 transition text-left shadow-sm';
            btn.textContent = opt.text;
            btn.onclick = () => handleAnswer(opt.correct);
            optionsContainer.appendChild(btn);
        });

        document.getElementById('tk-game-feedback').classList.add('hidden');
    }

    function handleAnswer(isCorrect) {
        if (isCorrect) {
            score++;
        }
        currentQuestion++;

        document.getElementById('score-display').textContent = `Punkte: ${score}/${quizData.length}`;

        if (currentQuestion < quizData.length) {
            loadQuestion();
        } else {
            showFinalResult();
        }
    }

    function showFinalResult() {
        document.getElementById('quiz-container').classList.add('hidden');
        document.getElementById('quiz-subtitle').textContent = "Quiz beendet! Hier ist dein offizielles Experten-Zeugnis:";

        const feedbackDiv = document.getElementById('tk-game-feedback');
        feedbackDiv.classList.remove('hidden');

        let evaluationText = "";
        if (score === 10) {
            evaluationText = `10/10 Punkte! Unfassbar! Du hast jede Detailfrage gemeistert, als hättest du den Reality-TV- und Royal-Klatsch eigenhändig geschrieben. Perfektion!`;
        } else if (score >= 7) {
            evaluationText = `${score}/10 Punkte! Richtig stark! Ein echtes Kenner-Ergebnis, das zeigt, dass dir so schnell niemand in Sachen Popkultur und Skandal-Wissen etwas vormacht.`;
        } else {
            evaluationText = `${score}/10 Punkte! Solide geschlagen! Auch wenn manche Insider-Frage knifflig war: Zum Geburtstag drücken wir mit größter Freude alle Augen zu, du bleibst die Nummer 1!`;
        }

        feedbackDiv.textContent = evaluationText;
        feedbackDiv.className = "p-3 rounded-xl text-xs font-medium bg-emerald-50 border border-emerald-200 text-emerald-900 mb-2 leading-relaxed";

        const nextBtn = document.getElementById('tk-game-next-btn');
        nextBtn.disabled = false;
        nextBtn.classList.remove('bg-stone-300', 'text-stone-500', 'cursor-not-allowed');
        nextBtn.classList.add('bg-amber-800', 'hover:bg-amber-700', 'text-white');
        nextBtn.textContent = 'Weiter im Geburtstagsticket!';
    }

    document.addEventListener("DOMContentLoaded", () => {
        loadQuestion();
    });
</script>