# Advent – Produktionswerte. Vorlage ohne echte Werte, nie echte Werte hier eintragen.
#
# Zwei Wege, die Werte an compose.prod.yaml zu geben (Ergebnis ist jedes Mal .env.prod.local im Stack-Ordner):
#  - Komodo (Standard): Werte im Stack unter „Environment“ (siehe deploy/komodo/advent.toml). Mit [SECRET]
#    markierte Werte als Komodo-Variable mit Häkchen „Secret“ anlegen (Settings → Variables, Name steht dabei)
#    und im Environment als Doppelklammer-Verweis einsetzen. Komodo schreibt .env.prod.local bei jedem Deploy neu –
#    die Datei auf dem Server also nicht von Hand ändern, sondern in Komodo.
#  - Werte erzeugen: `make prod-secrets` kopiert diese Datei nach .env.prod.local (überschreibt nichts) und füllt
#    die Secrets mit Zufallswerten. Von dort kommen sie beim ersten Einrichten nach Komodo; danach ist die Datei
#    auch der manuelle Notweg (`make prod-up`).
# .env.prod.local nie ins Repository. Die Secrets sicher aufbewahren (Passwortmanager): ohne die DB-Passwörter
# passt ein Dump nicht mehr zum Volume. Nach dem ersten Start NIE neu würfeln.

# --- Adresse ---------------------------------------------------------------------------------------------
# Öffentliche Adresse mit https:// (Links aus der Konsole). HTTPS macht der Caddy auf dem VPS.
# Komodo: fest in deploy/komodo/advent.toml.
DEFAULT_URI=https://kresh.wh-company.com

# --- Secrets ---------------------------------------------------------------------------------------------
# [SECRET] Symfony-Schlüssel (Sitzungen, CSRF). 64 Hex-Zeichen. Komodo: ADVENT_APP_SECRET
APP_SECRET=
# [SECRET] Passwort des Datenbank-Benutzers. Gilt nur beim allerersten Start; danach muss es zum bestehenden
# Volume passen. Komodo: ADVENT_MYSQL_PASSWORD
MYSQL_PASSWORD=
# [SECRET] Root-Passwort der Datenbank (auch für die Sicherungen). Wie oben. Komodo: ADVENT_MYSQL_ROOT_PASSWORD
MYSQL_ROOT_PASSWORD=
# [SECRET] Optional: Sentry-DSN für Fehlermeldungen (leer = aus). Komodo: ADVENT_SENTRY_DSN
# (ohne Sentry die Zeile im Komodo-Environment löschen statt eine leere Variable anzulegen)
SENTRY_DSN=

# --- Datenbank (fest, nicht ändern: gehört zum bestehenden Volume) ----------------------------------------
MYSQL_DATABASE=app
MYSQL_USER=app

# --- Eingang: Caddy auf dem VPS → WireGuard → hierher (docs/deployment.md) --------------------------------
# Port, auf dem dieser Rechner Advent per HTTP anbietet (der einzige Host-Port des Stacks). Auf abyss: 7999.
HTTP_PORT=7999
# Nur auf dieser Adresse lauschen – die WireGuard-IP dieses Rechners (abyss: 10.0.0.2).
# Komodo: fest in deploy/komodo/advent.toml.
HTTP_BIND=10.0.0.2
# Von wem X-Forwarded-For/-Proto übernommen werden: die WireGuard-IP des VPS-Caddys (10.0.0.1).
# Komodo: fest in deploy/komodo/advent.toml.
REVERSE_PROXY_IPS=10.0.0.1

# --- Sicherungen (Dienst backup, deploy/komodo/db-backup.sh) ----------------------------------------------
# Host-Ordner für die Datenbank-Dumps (außerhalb des Stack-Ordners). Muss existieren
# (einmalig: sudo install -d -m 700 /srv/advent/backups) – Docker legt ihn absichtlich nicht selbst an.
BACKUP_DIR=/srv/advent/backups
# So viele Dumps je Anlass (daily, pre-deploy, manuell) bleiben liegen; täglich 14 = zwei Wochen.
BACKUP_KEEP=14

# --- Nur für Fixtures --------------------------------------------------------------------------------------
# bcrypt-Hash für das Fixture-Konto (doctrine:fixtures:load, app:update-door). Im Betrieb nicht nötig, nicht in Komodo.
#USER_PASSWORD=

# --- Nur für Probeläufe ----------------------------------------------------------------------------------
# Präfix der Volume-Namen (Standard advent → advent_prod_mysql_data). Auf dem Server NIE setzen.
# Auf dem Entwicklungsrechner für Probeläufe PFLICHT (z. B. adventprobe) zusammen mit einem eigenen Projektnamen.
#VOLUME_PREFIX=adventprobe
